{
  "name": "ResilienceCockpit",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "@sap/cds-common-content": "^3.2.0",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch" 
  },
  "private": true,
  "cds": {
    "requires": {
      "db":{
        "kind":"sqlite",
        "credentials":{
        "url":"db.sqlite"
        }
      },
      "auth": {
        "kind": "basic",
        "users": {
          "alice": {
            "password": "alicepassword123",
            "roles": ["Admin", "User", "authenitcated-user"]
          },
          "bob": {
            "password": "bobpassword456",
            "roles": ["User","authenitcated-user"]
          }
        }
      },   
      "[production]": {
        "auth": "xsuaa"
      },
      "connectivity": true,
      "destinations": true,
      "html5-repo": true,
      "application-logging": true
    }
  }
}
